			<Project GUID="{6C13A83D-7CFE-45C7-87DA-8CFD6BC68B6F}" Name="Untitled1" PrjFilePath="Untitled1\Untitled1.plcproj" TmcFilePath="Untitled1\Untitled1.tmc" ReloadTmc="true" AmsPort="851" FileArchiveSettings="#x000e" SymbolicMapping="true">
				<Instance Id="#x08502000" TcSmClass="TComPlcObjDef" KeepUnrestoredLinks="2" TmcPath="Untitled1\Untitled1.tmc" TmcHash="{92591CB0-5065-7892-3626-DAA60A77408E}">
					<Name>Untitled1 Instance</Name>
					<CLSID ClassFactory="TcPlc30">{08500001-0000-0000-F000-000000000064}</CLSID>
					<Vars VarGrpType="1">
						<Name>PlcTask Inputs</Name>
						<Var>
							<Name>GVL.Gvl_EL1018_FeedRead_Gray</Name>
							<Comment><![CDATA[================ 硬件 I/O 映射 (倍率控制) ================
 [输入] EL1018 读取机床当前的进给倍率波段 (原始格雷码)]]></Comment>
							<Type>BYTE</Type>
						</Var>
						<Var>
							<Name>GVL.GvlDataAll</Name>
							<Comment><![CDATA[================ 模拟量采集缓存 (核心业务) ================
硬件绑定变量     包含：2×EL3632振动模块 + 1×EL3104电流模块 + 其他模拟量输入
预定义80个INT数组，其中2个3632最多占用22个，3104占用4个]]></Comment>
							<Type GUID="{F28FB359-A88E-CB91-5C4C-76AECF63BD40}">ARRAY [1..80] OF INT</Type>
						</Var>
						<Var>
							<Name>GVL.Gvl_Cmd_FeedRate_Set</Name>
							<Comment><![CDATA[================ 上位机交互信号 (使用明确命名) ================
 进给倍率 (0-150%)]]></Comment>
							<Type>WORD</Type>
						</Var>
						<Var>
							<Name>GVL.Gvl_Cmd_Spindle_Set</Name>
							<Comment><![CDATA[ 主轴倍率 (0-120%)]]></Comment>
							<Type>WORD</Type>
						</Var>
						<Var>
							<Name>GVL.Gvl_Cmd_Enable_Override</Name>
							<Comment><![CDATA[ 上位机决定是否启用倍率接管
 TRUE = PLC接管机床倍率; FALSE = 机床使用自身面板倍率]]></Comment>
							<Type>BOOL</Type>
						</Var>
					</Vars>
					<Vars VarGrpType="2" AreaNo="1">
						<Name>PlcTask Outputs</Name>
						<Var>
							<Name>GVL.Gvl_EL2008_FeedWrite_Gray</Name>
							<Comment><![CDATA[ [输出] EL2008_1 向机床写入进给倍率 (转换后的格雷码)]]></Comment>
							<Type>BYTE</Type>
						</Var>
						<Var>
							<Name>GVL.Gvl_EL2008_SpindleWrite_Gray</Name>
							<Comment><![CDATA[ [输出] EL2008_2 向机床写入主轴倍率 (转换后的格雷码)]]></Comment>
							<Type>BYTE</Type>
						</Var>
						<Var>
							<Name>GVL.Gvl_Override_Valid</Name>
							<Comment><![CDATA[ [输出] 倍率有效信号]]></Comment>
							<Type>BIT</Type>
						</Var>
						<Var>
							<Name>GVL.Gvl_Act_FeedRate_Real</Name>
							<Comment><![CDATA[ [输出] 反馈给上位机的状态 (Actual)
 当前实际进给倍率 (EL1018读取并解码后的值)]]></Comment>
							<Type>WORD</Type>
						</Var>
					</Vars>
